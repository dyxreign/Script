local function getActiveBoss()
    local targets = {"Tenth Beast", "Jigan", "Monashiki", "Gimshiki", "Monashiki (Awakened)", "Nisshiki Otsutsushi"}
    
    -- Checa Pain of Animal ou qualquer coisa com Pain no começo
    local enemyHolder = workspace:FindFirstChild("PathsOfPainFolder") and workspace.PathsOfPainFolder:FindFirstChild("enemyHolder")
    if enemyHolder then
        for _, child in ipairs(enemyHolder:GetChildren()) do
            if child.Name:sub(1, 4) == "Pain" then
                if child:FindFirstChild("HumanoidRootPart") and child:FindFirstChild("Humanoid") and child.Humanoid.Health > 0 then
                    return child
                end
            end
        end
    end
    
    for _, name in ipairs(targets) do
        local entity = workspace:FindFirstChild(name)
        if entity and entity:FindFirstChild("HumanoidRootPart") and entity:FindFirstChild("Humanoid") and entity.Humanoid.Health > 0 then
            return entity
        end
    end
    
    return nil
end

local function getNearestScroll(playerPos)
    local nearestScroll = nil
    local shortestDistance = math.huge
    local tycoonKit = workspace:FindFirstChild("Zednov's Tycoon Kit")
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if tycoonKit and obj:IsDescendantOf(tycoonKit) then continue end
        
        if obj.Name:match("Scroll") or obj.Name == "SScroll" then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local distance = (part.Position - playerPos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestScroll = part
                end
            end
        end
    end
    
    return nearestScroll
end

