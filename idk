-- 3. TOGGLE: VIEW PLAYER (Abaixo do Dropdown)
Tab:AddToggle({
	Name = "View Player (Spectate)",
	Default = false,
	Callback = function(Value)
		getgenv().ViewActive = Value
        
        if Value then
            local target = getgenv().SelectedTarget
            if target and target.Character and target.Character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = target.Character.Humanoid
            else
                OrionLib:MakeNotification({
                    Name = "Error",
                    Content = "Select a valid player first!",
                    Image = "rbxassetid://4483345998",
                    Time = 3
                })
                -- Reseta o toggle visualmente se não tiver target (opcional, mas complexo na lib, deixa assim)
            end
            
            -- Loop para manter a câmera caso o jogador morra/renasça
            task.spawn(function()
                while getgenv().ViewActive do
                    local t = getgenv().SelectedTarget
                    if t and t.Character and t.Character:FindFirstChild("Humanoid") then
                        if Camera.CameraSubject ~= t.Character.Humanoid then
                             Camera.CameraSubject = t.Character.Humanoid
                        end
                    end
                    task.wait(1)
                end
            end)
            
        else
            -- Volta para o LocalPlayer
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = LocalPlayer.Character.Humanoid
            end
        end
	end    
})

