-- Função para formatar lista de nomes: "Apelido (@NomeReal)"
local function GetPlayerOptions()
    local options = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local displayName = p.DisplayName
            local realName = p.Name
            table.insert(options, displayName .. " (@" .. realName .. ")")
        end
    end
    return options
end

-- Função para extrair o nome real da string do Dropdown
local function GetPlayerFromOption(optionString)
    -- Procura o texto que está entre "(@" e ")"
    local realName = optionString:match("%(@(.*)%)")
    if realName then
        return Players:FindFirstChild(realName)
    end
    return nil
end

