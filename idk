-- 1. TOGGLE: ESP PLAYERS (Acima do Dropdown)
Tab:AddToggle({
	Name = "ESP Players (Name + HP)",
	Default = false,
	Callback = function(Value)
		getgenv().ESPActive = Value
        
        if Value then
            -- Loop do ESP
            task.spawn(function()
                while getgenv().ESPActive do
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                            -- Verifica se já tem o ESP, senão cria
                            if not p.Character.Head:FindFirstChild("OrionESP") then
                                local bg = Instance.new("BillboardGui")
                                bg.Name = "OrionESP"
                                bg.Adornee = p.Character.Head
                                bg.Size = UDim2.new(0, 200, 0, 50)
                                bg.StudsOffset = Vector3.new(0, 2, 0)
                                bg.AlwaysOnTop = true
                                bg.Parent = p.Character.Head
                                
                                local text = Instance.new("TextLabel")
                                text.Parent = bg
                                text.Size = UDim2.new(1, 0, 1, 0)
                                text.BackgroundTransparency = 1
                                text.TextColor3 = Color3.fromRGB(255, 255, 255)
                                text.TextStrokeTransparency = 0
                                text.Font = Enum.Font.GothamBold
                                text.TextSize = 14
                                text.Name = "Info"
                            end
                            
                            -- Atualiza o Texto (Nome + Vida)
                            local espTag = p.Character.Head:FindFirstChild("OrionESP")
                            if espTag and espTag:FindFirstChild("Info") then
                                local hp = math.floor(p.Character.Humanoid.Health)
                                espTag.Info.Text = p.Name .. "\nHP: " .. hp
                                
                                -- Muda cor baseado na vida (Verde -> Vermelho)
                                if hp > 50 then
                                    espTag.Info.TextColor3 = Color3.fromRGB(0, 255, 0)
                                else
                                    espTag.Info.TextColor3 = Color3.fromRGB(255, 0, 0)
                                end
                            end
                        end
                    end
                    task.wait(0.5) -- Atualiza a cada meio segundo para não lagar
                end
            end)
        else
            -- Remove ESP ao desligar
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("OrionESP") then
                    p.Character.Head.OrionESP:Destroy()
                end
            end
        end
