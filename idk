-- 2. O SCRIPT QUE VOCÊ PEDIU (COM A INTEGRAÇÃO)
Tab:AddToggle({
	Name = "Fly & Noclip (PC & Mobile)",
	Default = false,
	Callback = function(Value)
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local Workspace = game:GetService("Workspace")
		local UserInputService = game:GetService("UserInputService")
		
		local plr = Players.LocalPlayer
		getgenv().FlyEnabled = Value
		
		if Value then
			-- Função para manter o voo
			task.spawn(function()
				while getgenv().FlyEnabled do
					local char = plr.Character
					local hum = char and char:FindFirstChild("Humanoid")
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local cam = Workspace.CurrentCamera

					if char and hum and root then
						
						-- 1. Ativa o Modo "Sem Física" (Para não cair)
						hum.PlatformStand = true
						root.Velocity = Vector3.new(0, 0, 0)
						
						-- 2. Lógica do Noclip (Atravessar paredes)
						for _, part in pairs(char:GetChildren()) do
							if part:IsA("BasePart") then
								part.CanCollide = false
							end
						end

						-- 3. Movimento Universal (Mobile e PC)
						local moveDir = hum.MoveDirection
						
                        -- PEGA A VELOCIDADE DO SLIDER
                        local currentSpeed = getgenv().FlySpeed

						if moveDir.Magnitude > 0 then
							-- Se o jogador estiver movendo, atualizamos o CFrame
							
                            -- Cálculo da nova posição
							local newPos = root.Position + (moveDir * currentSpeed)
							
							-- Truque para Mobile: Se olhar pra cima e andar, sobe.
							if cam.CFrame.LookVector.Y ~= 0 then
								newPos = newPos + Vector3.new(0, cam.CFrame.LookVector.Y * moveDir.Magnitude * currentSpeed, 0)
							end
							
							root.CFrame = CFrame.new(newPos, newPos + cam.CFrame.LookVector)
						else
							-- Se estiver parado, mantém a rotação da câmera (Drift Fix)
							root.CFrame = CFrame.new(root.Position, root.Position + cam.CFrame.LookVector)
						end

						-- 4. Controles Extras para PC (Espaço/Ctrl)
						if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
							root.CFrame = root.CFrame + Vector3.new(0, currentSpeed, 0)
						end
						if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
							root.CFrame = root.CFrame - Vector3.new(0, currentSpeed, 0)
						end
					end
					
					-- Executa a cada frame
					RunService.RenderStepped:Wait()
				end
			end)
		else
			-- Desativar
			local char = plr.Character
			if char and char:FindFirstChild("Humanoid") then
				char.Humanoid.PlatformStand = false
				
				-- Dá um pequeno "empurrão" para destravar a física
				if char:FindFirstChild("HumanoidRootPart") then
					char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
				end
			end
		end
	end    
})


